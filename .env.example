# ============================================================
#  FlowDJ Server — Environment Variables
#  Copy this file to .env and fill in your own values.
#  NEVER commit .env to git. Only .env.example is committed.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3001

# Network interface to bind to. Defaults to 127.0.0.1 (localhost-only).
# Set to 0.0.0.0 to expose on the LAN (e.g. when an OBS browser source
# on another machine needs to reach the dashboard). When binding to
# 0.0.0.0 you should also set API_TOKEN below.
HOST=127.0.0.1

# Optional shared-secret for mutating endpoints. When set, any non-
# localhost POST/PUT/PATCH/DELETE request must include:
#   Authorization: Bearer <token>
# GET stays open. Generate a random value:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Leave empty to disable (default).
API_TOKEN=

# Set true to allow chokidar to follow symbolic links during the music
# library scan. Disabled by default to avoid symlink-loop CPU
# exhaustion and watching paths outside the intended music dir.
FILE_WATCHER_FOLLOW_SYMLINKS=false

# Optional comma-separated whitelist of allowed music-library roots.
# When set, POST /api/directories and /api/directories/browse only accept
# paths within these roots. Without it, callers can probe arbitrary
# filesystem paths via these endpoints. Example:
#   ALLOWED_MUSIC_ROOTS=D:/Music,E:/DJ Sets
# Off by default.
ALLOWED_MUSIC_ROOTS=

# ── LLM Gateway (optional) ───────────────────────────────────
# URL of a self-hosted LLM gateway used for AI banter / autonomous
# decision-making in Live Stream mode. Leave at the default loopback
# if you are running one locally; otherwise the AI features simply
# degrade gracefully.
LLM_GATEWAY_URL=http://127.0.0.1:18789

# Or, instead, plug in Anthropic / OpenAI keys directly:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Music Library ────────────────────────────────────────────
# Comma-separated list of directories to scan for audio files.
# You can also add/remove these at runtime from the dashboard UI.
MUSIC_DIRS=/path/to/your/music

# ── YouTube OAuth2 (Live Stream mode only) ───────────────────
# Get these from Google Cloud Console → APIs & Services → Credentials.
# Create an "OAuth client ID" of type "Web application" and add
# http://localhost:3001/api/broadcast/auth/callback as an authorized
# redirect URI. You can also configure these from the dashboard UI
# (POST /api/broadcast/auth/config) at runtime.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/broadcast/auth/callback

# Your YouTube channel ID — used for live-chat polling and metrics.
YOUTUBE_CHANNEL_ID=

# ── OBS WebSocket (Live Stream mode only) ────────────────────
# Enable OBS's WebSocket server: Tools → WebSocket Server Settings.
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=

# ── Discord (optional) ───────────────────────────────────────
# A bot token enables the watchdog → Discord notifier so you get
# pinged when the stream halts. Leave blank to disable.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ── X / Twitter (optional) ───────────────────────────────────
# Enables auto-tweeting stream announcements + in-character posts.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_HANDLE=

# ── Broadcast Defaults ───────────────────────────────────────
DEFAULT_STREAM_TITLE=FlowDJ — Late Night Session
DEFAULT_STREAM_DURATION_MINS=180

# ── Vite Dev Server (CLIENT side only — for `npm run dev`) ───
# Where the dev server proxies /api/* requests. Override in .env.local
# if you're running the dashboard locally but the backend elsewhere.
#   VITE_API_HOST=http://localhost:3001         # backend on this machine
#   VITE_API_HOST=http://192.168.x.x:3001       # backend on another box
VITE_API_HOST=http://localhost:3001
